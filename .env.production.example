# Copy this file to .env.production on the VPS and replace every placeholder.
# Never commit .env.production or place real credentials in GitHub workflow files.

APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_A_GENERATED_32_BYTE_KEY
APP_URL=https://api.mrcln0305.xyz
FRONTEND_URL=https://mrcln0305.xyz
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

# Configure these after creating a Google OAuth web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.mrcln0305.xyz/auth/google/callback

VITE_API_BASE_URL=https://api.mrcln0305.xyz/api

APP_DB_DATABASE=osn_readiness
APP_DB_USERNAME=osn_app
APP_DB_PASSWORD=replace_with_a_long_random_hex_secret

INTERNAL_API_TOKEN=replace_with_a_different_long_random_hex_secret
