# Jangan bawa artefak lokal ke image produksi.
# - .env* : rahasia dev; env produksi diinjeksi compose saat start.
# - bootstrap/cache/*.php : manifest paket dev (mis. Laravel Boost) yang
#   providernya tidak ada setelah `composer install --no-dev`, dan membuat
#   `php artisan package:discover` gagal saat build.
# - vendor/node_modules : diinstall di dalam image.
# - tests/storage logs : tidak dipakai runtime.
# - public/storage : symlink hasil `storage:link` (target path Linux). BuildKit
#   gagal membaca symlink ini di host Windows ("invalid file request"). Saat
#   runtime folder tetap ada lewat bind mount, jadi tidak perlu ikut ke image.
.env
.env.*
.git
.github
vendor
node_modules
public/storage
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
tests
.phpunit.cache
.phpunit.result.cache
