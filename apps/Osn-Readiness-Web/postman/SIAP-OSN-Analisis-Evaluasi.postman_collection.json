      "name": "0. Autentikasi Admin",
      "item": [
        {
          "name": "Login Admin (Dapatkan Token Otomatis)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "description": "Login sebagai Super Admin untuk mendapatkan Sanctum Bearer Token. Script di Tests tab akan otomatis mengisi variabel {{admin_token}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response && response.data && response.data.token) {",
                  "    pm.collectionVariables.set('admin_token', response.data.token);",
                  "    console.log('Token admin berhasil disimpan ke {{admin_token}}:', response.data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
